[Unit]
Description=goldeneye-mcp-proxy daemon — shared MCP gateway for AI coding agents
Documentation=https://github.com/goldeneyeRathore/goldeneye-mcp-proxy
After=network.target

[Service]
Type=simple
Environment=NODE_ENV=production
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:%h/.local/share/pnpm:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env goldeneye-mcp-proxy --daemon %h/.config/goldeneye-mcp-proxy/config.json
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
